{
  "name": "metro-dash",
  "version": "1.1.0",
  "description": "A browser endless runner with realistic 3D, playable with the keyboard or with hand and body gestures through your webcam (on-device pose tracking).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rjach/metro-dash.git"
  },
  "keywords": [
    "game",
    "endless-runner",
    "threejs",
    "webgl",
    "mediapipe",
    "pose-estimation",
    "gesture-control",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "e2e:camera-video": "node e2e/make-performance.mjs",
    "tour": "node e2e/visual-tour.mjs",
    "perf": "node e2e/perf-probe.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
